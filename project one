#include <iostream>
#include <iomanip>
using namespace std;
int main(){
    char names[5][20];
    int marks[5][3];
    int total[5];
    double average[5];
    int top = 0;
  for (int i=0; i<5; i++){
        cout<<"Enter name of student "<<i+1<<": ";
        cin.getline(names[i], 20);
        for (int j=0; j<3; j++){
            cout<<"Enter mark "<<j+1<<": ";
            cin>>marks[i][j];
        }
        cin.ignore();
}
     for (int i=0; i<5; i++){
        total[i] = 0;
        for (int j=0; j<3; j++){
            total[i] += marks[i][j];
        }
        average[i] = total[i] / 3.0;
        if (total[i] > total[top]) top = i;
    }
  cout<<"\n"<<left<<setw(12)<<"Name"
        <<setw(6)<<"M1"<<setw(6)<<"M2"<<setw(6)<<"M3"
        <<setw(8)<<"Total"<<"Avg"<<endl;

    for (int i=0; i<5; i++){
        cout<<left<<setw(12)<<names[i];
        for (int j=0; j<3; j++){
            cout<<setw(6)<<marks[i][j];
        }
        cout<<setw(8)<<total[i]
            <<fixed<<setprecision(1)<<average[i]<<endl;
    }

    cout<<"\nTop student: "<<names[top]<<endl;
    return 0;
}
